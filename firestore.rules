rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // `follows` doc ID is `${followerUid}_${followeeUid}` (see useFollow.ts).
    // "followers"-visibility content must actually check this graph — just
    // requiring isAuthed() lets any signed-in stranger read it.
    function isFollowerOf(authorUid) {
      return isAuthed()
        && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + authorUid));
    }

    // users/{uid}/blocked/{otherUid} exists when uid has blocked otherUid.
    function hasBlocked(uid, otherUid) {
      return exists(/databases/$(database)/documents/users/$(uid)/blocked/$(otherUid));
    }

    // Set by onReportCreated once enough people report something. Only the
    // Admin SDK writes it, so an author can't un-hide their own post.
    function touchesModerationFlag() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderationHidden']);
    }

    // tier and its bookkeeping are written server-side only (syncTier and
    // reconcileTier, Admin SDK, which bypasses these rules entirely). The
    // bookkeeping matters as much as tier itself: both functions discard any
    // write older than tierEventTimestampMs, so a client that pushed that
    // cursor into the future would freeze its tier against every later
    // expiry, refund, and reconcile — Pro forever after cancelling.
    function serverTierFields() {
      return ['tier', 'tierEventTimestampMs', 'tierEventId', 'tierUpdatedAt', 'tierReconciledAtMs'];
    }

    // Following someone means updating THEIR followersCount, in the same
    // transaction that creates or deletes the follow doc (hooks/useFollow.ts).
    // Allowed only as a +1 that commits alongside a new follow by the caller,
    // or a -1 alongside its removal, so a count can't be inflated, drained,
    // or changed on its own. Mirrors the likesCount rule on posts. The -1 also
    // accepts 0 -> 0, the client's clamp for a count that had drifted.
    function isFollowCountChange(uid) {
      let followPath = /databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid);
      let before = resource.data.get('followersCount', 0);
      let after = request.resource.data.get('followersCount', 0);
      return isAuthed()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
        && (
          (!exists(followPath) && existsAfter(followPath) && after == before + 1)
          || (exists(followPath) && !existsAfter(followPath)
              && (after == before - 1 || (before == 0 && after == 0)))
        );
    }

    // Users collection
    match /users/{uid} {
      allow read: if isAuthed();
      // createUserProfile() omits tier; a new account is free by absence.
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(serverTierFields());
      allow update: if (
          isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverTierFields())
        )
        || isFollowCountChange(uid);
      allow delete: if false; // deleteUserData Cloud Function only

      // Personalized feed — written exclusively by Cloud Functions (Admin SDK)
      match /feed/{postId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Notifications
      match /notifications/{notifId} {
        allow read: if isOwner(uid);
        // Content is Cloud-Functions-only (Admin SDK); the owner may only
        // ever flip their own `read` field, never author/edit a notification.
        allow create: if false;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        // Deletion IS the owner's to make — it is their own inbox, and a list
        // that only ever grows is one people stop opening. Authoring stays
        // closed above: they can remove a row, never write or rewrite one.
        // Nothing else depends on the row surviving; a trip invite lives
        // server-side against the trip, so deleting its notification loses
        // the shortcut, not the invitation (see utils/notificationActions.ts,
        // which declines to offer delete on one still awaiting an answer).
        allow delete: if isOwner(uid);
      }

      // Saved trips
      match /savedTrips/{tripId} {
        allow read, write: if isOwner(uid);
      }

      // Accounts this user blocked (doc id = the blocked uid). Private: the
      // blocked person is never told, and can't read this. onBlockCreated
      // removes follows in both directions.
      match /blocked/{blockedUid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && blockedUid != uid;
      }

      // Content this user reported, hidden for them (doc id = contentKey()).
      match /hidden/{contentKey} {
        allow read, create, delete: if isOwner(uid);
      }
    }

    // Posts
    match /posts/{postId} {
      allow read: if resource.data.visibility == 'public' || isAuthed();
      allow create: if isAuthed() && request.auth.uid == request.resource.data.authorUid
        && !request.resource.data.keys().hasAny(['moderationHidden']);
      // Authors may update anything except the moderation flag; anyone signed in may bump ONLY the
      // denormalized like counter, and only by exactly +1/-1 per write (the
      // like transaction maintains it) — hasOnly() alone would let any
      // signed-in user set likesCount to an arbitrary value.
      allow update: if isAuthed() && !touchesModerationFlag() && (
        request.auth.uid == resource.data.authorUid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
          && (
            request.resource.data.likesCount == resource.data.likesCount + 1
            || request.resource.data.likesCount == resource.data.likesCount - 1
          )
        )
      );
      allow delete: if isAuthed() && request.auth.uid == resource.data.authorUid;

      // One like per user — doc ID is `${uid}_${postId}`, payload carries uid
      match /likes/{likeId} {
        allow read: if isAuthed();
        allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isAuthed() && resource.data.uid == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if isAuthed();
        // Not on the post of someone who blocked you.
        allow create: if isAuthed() && request.auth.uid == request.resource.data.authorUid
          && !request.resource.data.keys().hasAny(['moderationHidden'])
          && !hasBlocked(get(/databases/$(database)/documents/posts/$(postId)).data.authorUid, request.auth.uid);
        allow update: if isAuthed() && request.auth.uid == resource.data.authorUid && !touchesModerationFlag();
        allow delete: if isAuthed() && request.auth.uid == resource.data.authorUid;
      }
    }

    // Trips
    match /trips/{tripId} {
      function canRead() {
        return resource.data.visibility == 'public'
          || isOwner(resource.data.authorUid)
          || (resource.data.visibility == 'followers' && isFollowerOf(resource.data.authorUid))
          || request.auth.uid in resource.data.collaborators;
      }

      allow read: if canRead();
      allow create: if isAuthed() && request.auth.uid == request.resource.data.authorUid
        && !request.resource.data.keys().hasAny(['moderationHidden']);
      allow update: if isAuthed() && !touchesModerationFlag() && (
        isOwner(resource.data.authorUid)
        || request.auth.uid in resource.data.collaborators
      );
      allow delete: if isAuthed() && isOwner(resource.data.authorUid);

      // Trip days subcollection
      match /days/{dayId} {
        function parentTrip() {
          return get(/databases/$(database)/documents/trips/$(tripId));
        }
        function canReadTrip() {
          return parentTrip().data.visibility == 'public'
            || isOwner(parentTrip().data.authorUid)
            || (parentTrip().data.visibility == 'followers' && isFollowerOf(parentTrip().data.authorUid))
            || request.auth.uid in parentTrip().data.collaborators;
        }
        function canWriteTrip() {
          return isAuthed() && (
            isOwner(parentTrip().data.authorUid)
            || request.auth.uid in parentTrip().data.collaborators
          );
        }

        allow read: if canReadTrip();
        allow create, update, delete: if canWriteTrip();

        // Day activities subcollection
        match /activities/{activityId} {
          allow read: if canReadTrip();
          allow create, update, delete: if canWriteTrip();

          // Journal (TM-3) — note + photo refs for a visited stop, a fixed
          // single doc (no multiple entries). Read follows the trip's own
          // visibility via canReadTrip() — owner always, a non-owner only
          // once the trip is public/followers/collaborator-shared; not a
          // separate "published" flag. Write is OWNER-ONLY, deliberately
          // narrower than canWriteTrip() (which also allows collaborators).
          match /journal/{entryId} {
            allow read: if canReadTrip();
            allow write: if isAuthed() && isOwner(parentTrip().data.authorUid);
          }
        }
      }

      // Trip invites (request/accept) — doc ID is the invitee's uid.
      // Write is Cloud-Functions-only: accepting has to mutate the parent
      // trip's collaborators[], which a client-side rule can't safely let a
      // non-collaborator do to themselves, so both send and respond go
      // through inviteToTrip/respondToTripInvite (Admin SDK).
      match /invites/{inviteeUid} {
        function parentTrip() {
          return get(/databases/$(database)/documents/trips/$(tripId));
        }
        function canWriteTrip() {
          return isAuthed() && (
            isOwner(parentTrip().data.authorUid)
            || request.auth.uid in parentTrip().data.collaborators
          );
        }

        allow read: if isAuthed() && (inviteeUid == request.auth.uid || canWriteTrip());
        allow write: if false;
      }

      // Shared expense ledger — tracks who paid and who a cost splits among,
      // never moves real money. Same trust model as `days`: any collaborator
      // can add/edit/delete, same as splitting a real bill together.
      match /expenses/{expenseId} {
        function parentTrip() {
          return get(/databases/$(database)/documents/trips/$(tripId));
        }
        function canReadTrip() {
          return parentTrip().data.visibility == 'public'
            || isOwner(parentTrip().data.authorUid)
            || (parentTrip().data.visibility == 'followers' && isFollowerOf(parentTrip().data.authorUid))
            || request.auth.uid in parentTrip().data.collaborators;
        }
        function canWriteTrip() {
          return isAuthed() && (
            isOwner(parentTrip().data.authorUid)
            || request.auth.uid in parentTrip().data.collaborators
          );
        }

        allow read: if canReadTrip();
        allow create, update, delete: if canWriteTrip();
      }

      // Packing list — generated once (owner-gated, client-side) then
      // editable by any collaborator, same trust model as `days`/`expenses`.
      // Being a collaborator IS the "share this list" mechanism.
      match /packingItems/{itemId} {
        function parentTrip() {
          return get(/databases/$(database)/documents/trips/$(tripId));
        }
        function canReadTrip() {
          return parentTrip().data.visibility == 'public'
            || isOwner(parentTrip().data.authorUid)
            || (parentTrip().data.visibility == 'followers' && isFollowerOf(parentTrip().data.authorUid))
            || request.auth.uid in parentTrip().data.collaborators;
        }
        function canWriteTrip() {
          return isAuthed() && (
            isOwner(parentTrip().data.authorUid)
            || request.auth.uid in parentTrip().data.collaborators
          );
        }

        allow read: if canReadTrip();
        allow create, update, delete: if canWriteTrip();
      }
    }

    // Username claims — doc ID is the lowercase username, payload is the
    // owning uid. Uniqueness is enforced structurally: a claim can only be
    // created (never updated), so taking over an existing username fails at
    // the rules layer even inside a transaction.
    //
    // Read is PUBLIC (not gated by isAuthed()) deliberately: usernames are
    // public handles by design (shown on posts/profiles to everyone), and
    // sign-up needs to check availability before an account — and therefore
    // an auth session — exists. The doc body is just {uid}, no more exposed
    // than a public profile already is.
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAuthed() && resource.data.uid == request.auth.uid;
    }

    // Follows
    // Doc ID is `${followerUid}_${followeeUid}`; isFollowerOf() above and
    // createDmThread look follows up by that ID, so it has to match the fields.
    // No update: re-following an existing doc would be a double count.
    match /follows/{docId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followeeUid is string
        && request.resource.data.followeeUid != request.auth.uid
        && docId == request.auth.uid + '_' + request.resource.data.followeeUid
        // Neither side may have blocked the other.
        && !hasBlocked(request.resource.data.followeeUid, request.auth.uid)
        && !hasBlocked(request.auth.uid, request.resource.data.followeeUid);
      allow delete: if isAuthed() && resource.data.followerUid == request.auth.uid;
    }

    // Usage quotas — server-side only (Admin SDK)
    match /usage_quotas/{uid} {
      allow read, write: if false;
    }

    // Direct messages — thread creation validates a variable-length
    // participants array against the mutual-follow graph, which security
    // rules can't express (no loop/forall over an array). createDmThread
    // (Admin SDK) is the only way a thread doc comes into existence.
    match /dmThreads/{threadId} {
      allow read: if isAuthed() && request.auth.uid in resource.data.participants;
      allow create, update: if false;
      allow delete: if false;

      match /messages/{messageId} {
        function thread() {
          return get(/databases/$(database)/documents/dmThreads/$(threadId));
        }
        allow read: if isAuthed() && request.auth.uid in thread().data.participants;
        allow create: if isAuthed()
          && request.auth.uid in thread().data.participants
          // In a one-to-one thread, not to someone who blocked you. Blocking
          // yourself is refused, so checking both participants is enough.
          && (
            thread().data.type != 'direct'
            || (
              !hasBlocked(thread().data.participants[0], request.auth.uid)
              && !hasBlocked(thread().data.participants[1], request.auth.uid)
            )
          )
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }

      // One doc per participant — each side's own read cursor. Splitting
      // this out (instead of a map field on the thread doc) avoids two
      // participants needing shared write access to the same parent doc.
      match /reads/{uid} {
        function thread() {
          return get(/databases/$(database)/documents/dmThreads/$(threadId));
        }
        allow read, write: if isOwner(uid) && request.auth.uid in thread().data.participants;
      }
    }

    // Reports
    // Reports — create-only, one per person per target (the id is
    // `${reporterUid}__${contentKey}`, see utils/moderation.ts), so repeats
    // can't stack toward onReportCreated's auto-hide threshold. Nobody reads
    // them from the client; moderators use the console (docs/moderation.md).
    match /reports/{reportId} {
      allow create: if isAuthed()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetOwnerUid != request.auth.uid
        && request.resource.data.targetType in ['post', 'comment', 'message', 'trip', 'user']
        && request.resource.data.reason in ['spam', 'harassment', 'hate', 'sexual', 'violence', 'impersonation', 'other']
        && request.resource.data.status == 'open'
        && reportId == request.auth.uid + '__' + request.resource.data.targetKey
        && (request.resource.data.details == null
            || (request.resource.data.details is string && request.resource.data.details.size() <= 500))
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'targetType', 'targetId', 'targetParentId', 'targetOwnerUid',
          'targetKey', 'reason', 'details', 'status', 'createdAt'
        ]);
      allow read, update, delete: if false;
    }

    // Boarding passes
    match /boarding_passes/{passId} {
      allow read, update, delete: if isAuthed() && isOwner(resource.data.ownerUid);
      allow create: if isAuthed() && request.auth.uid == request.resource.data.ownerUid;
    }

    // Reservations
    match /reservations/{reservationId} {
      allow read, update, delete: if isAuthed() && isOwner(resource.data.ownerUid);
      allow create: if isAuthed() && request.auth.uid == request.resource.data.ownerUid;
    }

    // Loyalty programs
    match /loyalty_programs/{programId} {
      allow read, update, delete: if isAuthed() && isOwner(resource.data.ownerUid);
      allow create: if isAuthed() && request.auth.uid == request.resource.data.ownerUid;
    }

    // Shared cache of Google Places tier2 data, keyed by Google's own place id
    // (see services/places/placeCache.ts). Deliberately global and not
    // per-user: the first person to open a place pays Google for it, everyone
    // after reads Firestore, which is orders of magnitude cheaper.
    //
    // Any signed-in user may write, because the client is what makes the
    // Google call. That is a real trade — a determined user could write junk
    // into a place entry. Accepted because the blast radius is a wrong photo
    // or rating on a place card, never anything about another user's data,
    // and routing this through a Cloud Function would add an invocation cost
    // to the very call we are trying to make cheap. cachedAt must be the
    // server's clock so a forged future timestamp cannot pin an entry past
    // its TTL, and no document may carry a uid, which keeps this from being
    // repurposed as unvalidated user-owned storage.
    match /places/{placeId} {
      allow read: if isAuthed();
      allow create, update: if isAuthed()
        && request.resource.data.cachedAt == request.time
        && !('ownerUid' in request.resource.data)
        && !('uid' in request.resource.data);
      allow delete: if false;
    }
  }
}
