rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Media for posts — photos up to 100 MB; video clips (compressed on the phone, utils/videoPost) up to 40 MB
    match /posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*|video/.*')
        && request.resource.size <= (request.resource.contentType.matches('video/.*') ? 40 : 100) * 1024 * 1024;
    }

    // User profile photos — max 5 MB, images only
    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Trip journal photos (TM-3) — read is public like posts/profile_photos:
    // the actual privacy gate is discoverability of the URL, enforced by the
    // Firestore journal subcollection's own rule (owner, or non-owner only
    // once the trip is shared). Write stays owner-only, matching that rule.
    match /journal_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Photos on place reviews (placeReviews) — the author's own folder, images only, ≤10 MB.
    // A delete is a write with no resource: allowed so authors can remove their photos.
    match /place_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && (request.resource == null
            || (request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }

    // Wish-list screenshots (spec 2026-11-11) — private to the owner; 0.jpg…4.jpg caps a save at 5; JPEG under 2 MB; no update.
    match /wish_shots/{userId}/{saveId}/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && file.matches('[0-4][.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 2 * 1024 * 1024;
    }

    // Place photos — max 5 MB, images only
    match /places/{placeId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Reservation confirmation photos — private to owner
    match /reservations/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
