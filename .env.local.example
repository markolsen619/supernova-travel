# Firebase — copy this to .env.local and fill in your Firebase project values
# Get these from: Firebase Console → Project Settings → Your apps → Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps / Places API key (for Google Places UI Kit)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# RevenueCat API keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Algolia search
EXPO_PUBLIC_ALGOLIA_APP_ID=
EXPO_PUBLIC_ALGOLIA_SEARCH_KEY=

# Mapbox — public access token (pk.eyJ1…), safe to commit
EXPO_PUBLIC_MAPBOX_TOKEN=
# Mapbox secret download token (sk.eyJ1…) — BUILD TIME ONLY, never expose to client
# Set as an EAS secret: eas secret:create --scope project --name MAPBOX_SECRET_DOWNLOAD_TOKEN --value sk.eyJ1...
MAPBOX_SECRET_DOWNLOAD_TOKEN=
